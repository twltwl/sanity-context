{
  "name": "sanity-context",
  "version": "0.2.0",
  "description": "Sanity Studio plugin for managing studio-wide context (brand, locale, market, etc.)",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Tommy Ljungberg",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "vite --config dev/vite.config.ts",
    "link-watch": "plugin-kit link-watch",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "peerDependencies": {
    "@sanity/icons": ">=2",
    "@sanity/ui": ">=2",
    "react": "^18",
    "sanity": "^3"
  },
  "devDependencies": {
    "@sanity/icons": "^2",
    "@sanity/pkg-utils": "^6",
    "@sanity/plugin-kit": "^4",
    "@sanity/ui": "^2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4",
    "eslint": "^9",
    "react": "^18",
    "react-dom": "^18",
    "sanity": "^3",
    "styled-components": "^6",
    "typescript": "^5",
    "vite": "^5"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "packageName": false,
      "sanityV2Json": false,
      "eslintImports": false
    }
  },
  "allowScripts": {
    "esbuild@0.25.6": true,
    "esbuild@0.25.12": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.0": true,
    "esbuild@0.21.5": true
  }
}
