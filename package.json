{
  "name": "sanity-context",
  "version": "1.0.0",
  "description": "Sanity Studio plugin for managing studio-wide context (brand, locale, market, etc.)",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "license": "MIT",
  "author": "Tommy Ljungberg",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "vite --config dev/vite.config.ts",
    "format": "oxfmt .",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5",
    "@sanity/ui": "^4"
  },
  "peerDependencies": {
    "react": "^19",
    "sanity": "^6"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^12",
    "@sanity/plugin-kit": "^10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "^19",
    "react-dom": "^19",
    "sanity": "^6",
    "styled-components": "^6",
    "typescript": "^7",
    "vite": "^8"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "packageName": false
    }
  },
  "browserslist": "extends @sanity/browserslist-config",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
